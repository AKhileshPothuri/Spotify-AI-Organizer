# Spotify OAuth (get from developer.spotify.com)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# Spotify requires HTTPS for redirect URIs. For local dev use a tunnel:
#   npx localtunnel --port 3000   → https://xxxx.loca.lt
#   ngrok http 3000               → https://xxxx.ngrok-free.app
# Register the tunnel URL in your Spotify app dashboard, then set it here.
# For production: https://yourdomain.com/api/auth/callback
SPOTIFY_REDIRECT_URI=https://your-tunnel-url.loca.lt/api/auth/callback

# LLM Provider Configuration
# Options: claude, openai, gemini, ollama (default: claude)
LLM_PROVIDER=claude

# Anthropic (Claude) API Key - get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-

# OpenAI API Key (optional) - get from platform.openai.com
# OPENAI_API_KEY=sk-

# Google Generative AI API Key (optional) - get from makersuite.google.com
# GOOGLE_API_KEY=

# Ollama Configuration (for local/self-hosted LLMs)
# OLLAMA_BASE_URL=http://localhost:11434

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spotify_organizer
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Application URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001

# Node Environment
NODE_ENV=development

# Optional: Logging & Analytics (none by default)
LOG_LEVEL=info

# Optional: Feature Flags
FEATURE_AUTO_SYNC=false
FEATURE_CUSTOM_TAXONOMY=true

# Optional: Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Optional: Batch Processing
BATCH_SIZE=25
MAX_CONCURRENT_LLM_CALLS=5

# Optional: Session & Cookies
SESSION_COOKIE_SECURE=false    # Set to true in production with HTTPS
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=Lax
