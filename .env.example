# ─── Spotify OAuth ─────────────────────────────────────────────────────────────
# Get from https://developer.spotify.com → Your App → Settings
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Spotify accepts http://127.0.0.1 (not localhost) for local OAuth — no tunnel needed.
# Register exactly this URI in your Spotify app dashboard, then use it here.
# For production: https://yourdomain.com/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Options: claude | openai | gemini | ollama  (default: claude)
LLM_PROVIDER=claude

# Anthropic (Claude) — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI (optional) — get from https://platform.openai.com
# OPENAI_API_KEY=sk-your_key_here

# Google Gemini (optional) — get from https://aistudio.google.com
# GOOGLE_API_KEY=your_key_here

# Ollama (optional, for self-hosted local models)
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Database ──────────────────────────────────────────────────────────────────
# Started automatically by: pnpm docker:up
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spotify_organizer

# Redis — required by config schema; BullMQ job queue (v0.4+)
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-32-char-secret-in-production
JWT_EXPIRES_IN=7d

# ─── Application URLs ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL is exposed to the browser (must be NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://127.0.0.1:3000

# ─── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Batch Processing (optional) ───────────────────────────────────────────────
BATCH_SIZE=25
MAX_CONCURRENT_LLM_CALLS=5

# ─── Rate Limiting (optional) ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
