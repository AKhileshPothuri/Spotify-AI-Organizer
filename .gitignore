# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# Commit pnpm-lock.yaml for reproducible installs (pnpm recommendation).
# Ignore accidental npm/yarn lockfiles from other package managers.
yarn.lock
package-lock.json

# ─── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.envrc

# Prisma CLI reads .env next to schema.prisma — keep it out of VCS
apps/api/prisma/.env

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ─── SSL / certificates ───────────────────────────────────────────────────────
*.pem
certificates/

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.AppleDouble

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
junit.xml

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Runtime ──────────────────────────────────────────────────────────────────
pids/
*.pid
*.rdb

# ─── Temp ─────────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp

# ─── Local docs (not for public VCS) ─────────────────────────────────────────
Local Docs/
Local_Docs/
docs/local/

# ─── Claude Code memory (project-local, not for public VCS) ──────────────────
.claude/

# ─── Python (if any tooling is added) ────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
